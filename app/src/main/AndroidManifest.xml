<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <queries>
        <package android:name="com.max.xiaoheihe" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="xiaoheihe" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:description="@string/module_description"
        android:hasCode="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.HeyBoxHook">

        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="portrait"
            android:taskAffinity="com.max.xiaoheihe"
            android:excludeFromRecents="true" />

        <receiver
            android:name=".ConfigReceiver"
            android:exported="true" />
    </application>

</manifest>
